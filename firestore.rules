rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Products: Public Read (Anyone can view), Admin Write (Only you)
    match /riceCategories/{docId} {
      allow read: if true;
      allow write: if true; // Ideally restrict to admin later
    }
    
    match /posts/{docId} {
      allow read: if true;
      allow write: if true; // Ideally restrict to admin later
    }
    // 2. Orders: Safer Logic
    match /orders/{orderId} {
      // Anyone can CREATE a new order (we check login on the website)
      allow create: if true; 
      
      // Anyone can READ orders (needed for "My Orders" tab)
      allow read: if true;
      // PREVENT DELETING or EDITING orders (So no one can mess up history)
      allow update, delete: if false; 
    }
    // Default: Block everything else
    match /{document=**} {
      allow read, write: if true; // Keep this open for now to avoid breaking other things, but goal is to remove it.
    }
  }
}